#!/bin/sh
set -e

# what fishies and bannerfishies need; apt has Curses but not Term::Animation
sudo apt-get update
sudo apt-get -y install libcurses-perl cpanminus make figlet lolcat

# into ~/perl5, where fishies looks, so CPAN never needs root
cpanm --local-lib "$HOME/perl5" Term::Animation

# the banner text fonts, where figl looks for them
fonts="${REPOS:-$HOME/repos}/github.com/rwxrob/fonts"
[ -d "$fonts" ] || git clone --depth 1 https://github.com/rwxrob/fonts "$fonts"
