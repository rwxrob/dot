#!/bin/sh
set -e

src=$(cd -- "$(dirname -- "$0")" && { realpath . 2>/dev/null || pwd; })

# downloads the font and unpacks it into the given directory
fetch_font() {
	curl -fsSL -o "$tmp/UbuntuMono.tar.xz" \
		https://github.com/ryanoasis/nerd-fonts/releases/latest/download/UbuntuMono.tar.xz
	mkdir -p "$1"
	tar -xJf "$tmp/UbuntuMono.tar.xz" -C "$1"
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# runs PowerShell on the Windows host, from a Windows drive so that Windows
# never sees a WSL path as its current directory
winps() (
	cd "$(dirname -- "$powershell")"
	"$powershell" -NoProfile -NonInteractive -Command \
		"\$ErrorActionPreference = 'Stop'; [Console]::OutputEncoding = [Text.Encoding]::UTF8; $1" \
		</dev/null | tr -d '\r'
)

# under WSL, wezterm is a Windows program: its config and fonts go on the host
setup_wsl() {
	powershell=$(command -v powershell.exe ||
		echo "$(wslpath -u 'C:\Windows')/System32/WindowsPowerShell/v1.0/powershell.exe")
	profile=$(winps '$env:USERPROFILE') || profile=
	if [ -z "$profile" ]; then
		echo "cannot run PowerShell on the Windows host; is WSL interop enabled?" >&2
		exit 1
	fi

	# a copy, because Windows cannot reliably follow links into WSL
	dest="$(wslpath -u "$profile")/.wezterm.lua"
	if cmp -s "$src/wezterm.lua" "$dest"; then
		echo "$dest is up to date"
	else
		if [ -e "$dest" ]; then
			backup="$dest.$(date +%Y%m%d%H%M%S).bak"
			cp "$dest" "$backup"
			echo "Saved the old config as $backup"
		fi
		cp "$src/wezterm.lua" "$dest"
		echo "Copied wezterm.lua to $dest (run setup again after changing it)"
	fi

	# installed means registered (for this user or everyone) and on disk
	missing=$(winps '
		$found = foreach ($hive in "HKCU:", "HKLM:") {
			$key = Get-Item "$hive\Software\Microsoft\Windows NT\CurrentVersion\Fonts" -ErrorAction SilentlyContinue
			foreach ($name in $key.Property) {
				$file = [string]$key.GetValue($name)
				if (-not [IO.Path]::IsPathRooted($file)) { $file = "$env:WINDIR\Fonts\$file" }
				if (Test-Path -LiteralPath $file) { Split-Path $file -Leaf }
			}
		}
		foreach ($style in "Regular", "Bold", "Italic", "BoldItalic") {
			if ($found -notcontains "UbuntuMonoNerdFont-$style.ttf") { $style }
		}')
	if [ -z "$missing" ]; then
		echo "UbuntuMono Nerd Font already installed on Windows"
		return
	fi

	# installed for this user only, which needs no administrator rights
	echo "Installing UbuntuMono Nerd Font on Windows"
	localappdata=$(winps '$env:LOCALAPPDATA')
	fonts="$(wslpath -u "$localappdata")/Microsoft/Windows/Fonts"
	mkdir -p "$fonts"
	fetch_font "$tmp/font"
	for file in "$tmp/font"/UbuntuMonoNerdFont*.ttf; do
		# a file already there may be in use, which makes it unwritable
		[ -e "$fonts/${file##*/}" ] || cp "$file" "$fonts/"
	done
	winps '
		$key = "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts"
		if (-not (Test-Path $key)) { New-Item $key -Force | Out-Null }
		Get-ChildItem "$env:LOCALAPPDATA\Microsoft\Windows\Fonts" -Filter "UbuntuMonoNerdFont*.ttf" | ForEach-Object {
			New-ItemProperty $key -Name "$($_.BaseName) (TrueType)" -Value $_.FullName -PropertyType String -Force | Out-Null
		}'
	echo "Font installed; restart WezTerm to use it"
}

if [ "$(uname)" = Linux ] && grep -qi microsoft /proc/version; then
	setup_wsl
	exit 0
fi

ln -sf "$src/wezterm.lua" "$HOME/.wezterm.lua"

# wezterm.lua uses 'UbuntuMono Nerd Font'; install it if it is missing
if [ "$(uname)" = Darwin ]; then
	# only the real font folders count; fc-list can see fonts wezterm cannot
	have=$(ls "$HOME/Library/Fonts" /Library/Fonts 2>/dev/null | grep -c 'UbuntuMonoNerdFont' || true)
elif command -v fc-list >/dev/null 2>&1; then
	have=$(fc-list | grep -c 'UbuntuMono Nerd Font' || true)
else
	have=0
fi

if [ "$have" -gt 0 ]; then
	echo "UbuntuMono Nerd Font already installed"
	exit 0
fi

echo "Installing UbuntuMono Nerd Font"
if [ "$(uname)" = Darwin ]; then
	if ! command -v brew >/dev/null 2>&1; then
		echo "Homebrew not found; install it or get the font from https://www.nerdfonts.com/font-downloads" >&2
		exit 1
	fi
	brew install --cask font-ubuntu-mono-nerd-font
else
	dest="$HOME/.local/share/fonts/UbuntuMonoNerd"
	fetch_font "$dest"
	command -v fc-cache >/dev/null 2>&1 && fc-cache -f "$dest"
fi
