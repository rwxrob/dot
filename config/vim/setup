#!/bin/bash

if [[ -z "$(which vim)" || -z "$(which vimtutor)" ]]; then
	echo "Warning, doesn't look like you have full Vim version."
fi

ln -sf "$PWD/vimrc" "$HOME/.vimrc"

mkdir -p "$HOME/.vim/autoload"
ln -sf "$PWD/plug.vim" "$HOME/.vim/autoload/plug.vim"

mkdir -p "$HOME/.vim/spell"
ln -sf "$PWD/en.utf-8.add.spl" "$HOME/.vim/spell/en.utf-8.add.spl"
mkdir -p "$HOME/.vim/spell"
ln -sf "$PWD/en.utf-8.add" "$HOME/.vim/spell/en.utf-8.add"
mkdir -p "$HOME/.config/cspell/"
ln -sf "$PWD/cspell.json" "$HOME/.config/cspell/cspell.json"

mkdir -p "$HOME/.config/rumdl/"
ln -sf "$PWD/rumdl.toml" "$HOME/.config/rumdl/rumdl.toml"

mkdir -p "$HOME/.config/nvim"
ln -sf "$PWD/init.lua" "$HOME/.config/nvim/init.lua"
