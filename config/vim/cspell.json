{
  "$schema": "https://githubusercontent.com",
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "spellfile",
      "path": "~/.vim/spell/en.utf-8.add",
      "addWords": true
    }
  ],
  "dictionaries": [
    "spellfile"
  ],
  "languageSettings": [
    {
      "languageId": "shellscript,bash,sh",
      "includeRegExpList": ["string"]
    }
  ],
  "overrides": [
    {
      "filename": [
        "**/bashrc",
        "**/profile",
        "**/inputrc",
        "**/scripts/*",
        "**/install/**/install-*"
      ],
      "languageId": "shellscript"
    }
  ]
}
