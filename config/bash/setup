#!/bin/sh
set -e

src=$(CDPATH= cd -- "$(dirname -- "$0")" && { realpath . 2>/dev/null || pwd; })
root=$(CDPATH= cd -- "$src/../.." && { realpath . 2>/dev/null || pwd; })

ln -sf "$src/bashrc" "$HOME/.bashrc"
ln -sf "$src/profile" "$HOME/.profile"
ln -sf "$src/profile" "$HOME/.bash_profile"
ln -sf "$src/inputrc" "$HOME/.inputrc"
ln -sf "$src/dircolors" "$HOME/.dircolors"

# Record who I am on GitHub and where this repo lives, once, so bashrc
# never has to assume the login name matches the GitHub user or that the
# repo is cloned under ~/repos/github.com/<user>/dot. Override with
# GITUSER=name ./setup. bashrc sources this file if it exists.
gituser=${GITUSER:-}
[ -n "$gituser" ] || gituser=$(gh api user -q .login 2>/dev/null) || gituser=
[ -n "$gituser" ] || gituser=$(git config --get github.user 2>/dev/null) || gituser=
[ -n "$gituser" ] || gituser=${USER:-$(whoami)}

env_dir=${XDG_CONFIG_HOME:-$HOME/.config}/dot
mkdir -p "$env_dir"

# Time zone: default to $TZ, then the previous answer, then this
# computer's setting; ask when run from a terminal.
tz=${TZ:-}
if [ -z "$tz" ] && [ -r "$env_dir/env" ]; then
	tz=$(sed -n "s/^export TZ='\(.*\)'\$/\1/p" "$env_dir/env")
fi
[ -n "$tz" ] || tz=$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||') || tz=
[ -n "$tz" ] || tz=$(cat /etc/timezone 2>/dev/null) || tz=
if [ -t 0 ]; then
	printf 'Time zone [%s]: ' "$tz"
	read -r answer || answer=
	[ -z "$answer" ] || tz=$answer
fi
if [ -n "$tz" ] && [ ! -e "/usr/share/zoneinfo/$tz" ]; then
	echo "warning: /usr/share/zoneinfo/$tz not found" >&2
fi

{
	echo "# generated by config/bash/setup; machine-local, not committed"
	echo "export GITUSER='$gituser'"
	echo "export DOTFILES='$root'"
	[ -z "$tz" ] || echo "export TZ='$tz'"
} >"$env_dir/env"
echo "GITUSER=$gituser DOTFILES=$root TZ=${tz:-(system)} (written to $env_dir/env)"

# static completions so bashrc doesn't run `<tool> completion bash` per shell
"$src/gen-completions"
