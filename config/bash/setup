#!/bin/sh
set -e

src=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$src/../.." && pwd)

ln -sf "$src/bashrc" "$HOME/.bashrc"
ln -sf "$src/profile" "$HOME/.profile"
ln -sf "$src/profile" "$HOME/.bash_profile"
ln -sf "$src/inputrc" "$HOME/.inputrc"
ln -sf "$src/dircolors" "$HOME/.dircolors"

# Record who I am on GitHub and where this repo lives, once, so bashrc
# never has to assume the login name matches the GitHub user or that the
# repo is cloned under ~/repos/github.com/<user>/dot. Override with
# GITUSER=name ./setup. bashrc sources this file if it exists.
gituser=${GITUSER:-}
[ -n "$gituser" ] || gituser=$(gh api user -q .login 2>/dev/null) || gituser=
[ -n "$gituser" ] || gituser=$(git config --get github.user 2>/dev/null) || gituser=
[ -n "$gituser" ] || gituser=${USER:-$(whoami)}

env_dir=${XDG_CONFIG_HOME:-$HOME/.config}/dot
mkdir -p "$env_dir"
cat >"$env_dir/env" <<EOF
# generated by config/bash/setup; machine-local, not committed
export GITUSER='$gituser'
export DOTFILES='$root'
EOF
echo "GITUSER=$gituser DOTFILES=$root (written to $env_dir/env)"

# static completions so bashrc doesn't run `<tool> completion bash` per shell
"$src/gen-completions"
