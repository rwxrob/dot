#!/bin/sh
set -e

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/opencode
ask_dir=${XDG_DATA_HOME:-$HOME/.local/share}/ask
src=$(cd -- "$(dirname -- "$0")" && { realpath . 2>/dev/null || pwd; })

mkdir -p "$config_dir"
ln -sf "$src/cli.json" "$config_dir/cli.json"
ln -sf "$src/opencode.jsonc" "$config_dir/opencode.jsonc"
ls -l "$config_dir/cli.json" "$config_dir/opencode.jsonc"

# local plugins, which OpenCode finds on its own (-n replaces an old link
# instead of creating another one inside the directory it points to)
mkdir -p "$config_dir/plugins"
ln -sfn "$src/plugins/tmux-bell" "$config_dir/plugins/tmux-bell"
ls -l "$config_dir/plugins/tmux-bell"

# working directory for the ask script (see bin/ask)
mkdir -p "$ask_dir"
ln -sf "$src/ask/AGENTS.md" "$ask_dir/AGENTS.md"
ls -l "$ask_dir/AGENTS.md"
