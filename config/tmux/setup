#!/usr/bin/env bash
here=$(CDPATH= cd -- "$(dirname -- "$0")" && { realpath . 2>/dev/null || pwd; })
if [[ ! $(type tmux) ]]; then
	echo "TMUX isn't installed. Skipping."
	exit 1
fi
ln -sf "$here/tmux.conf" "$HOME/.tmux.conf"
ln -sf "$here/tmux-live.conf" "$HOME/.tmux-live.conf"
ln -sf "$here/tmux-plain.conf" "$HOME/.tmux-plain.conf"
