#!/bin/bash
#
# Opens what you would expect, on macOS, Linux and WSL.
#
#   open                 opens the current directory
#   open -a App file     any option goes straight to the system opener
#   open file dir ...    existing paths go to the system opener as they are
#   open README.md       a lone markdown file renders in lynx (needs pandoc)
#   open example.com     anything else is a URL, https:// is added if missing
#
# This shadows /usr/bin/open on macOS (the dot bin is early in PATH), so it
# must keep every argument and option working exactly as the real one does.

set -u

opener=
if [[ -x /usr/bin/open ]]; then
	opener=/usr/bin/open
elif type xdg-open &>/dev/null; then
	opener=xdg-open
elif type wslview &>/dev/null; then
	opener=wslview
elif type explorer.exe &>/dev/null; then
	opener=explorer.exe
fi

if [[ -z "$opener" ]]; then
	echo "open: no system opener found" >&2
	exit 1
fi

# nothing given: the current directory
((${#} == 0)) && exec "$opener" .

# options belong to the real opener
[[ "$1" == -* ]] && exec "$opener" "$@"

# one markdown file: read it in the terminal when the tools are there
if (($# == 1)) && [[ -f "$1" && "$1" == *.md ]] &&
	type pandoc &>/dev/null && type lynx &>/dev/null; then
	html=$(mktemp "${TMPDIR:-/tmp}/open.XXXXXX.html")
	trap 'rm -f "$html"' EXIT
	pandoc -s -o "$html" "$1" 2>/dev/null && lynx "$html"
	exit
fi

# every argument that is a path (or already a URL) is passed straight through
all=1
for arg in "$@"; do
	[[ -e "$arg" || "$arg" =~ ^[A-Za-z][A-Za-z0-9+.-]*: ]] || all=0
done
((all)) && exec "$opener" "$@"

# anything else is a bare URL
urls=()
for arg in "$@"; do
	if [[ -e "$arg" || "$arg" =~ ^[A-Za-z][A-Za-z0-9+.-]*: ]]; then
		urls+=("$arg")
	else
		urls+=("https://$arg")
	fi
done
exec "$opener" "${urls[@]}"
