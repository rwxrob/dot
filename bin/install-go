#!/usr/bin/perl
use v5.26;

# Installs the latest Go release into ~/.local/go (no root needed) on macOS
# and Linux.

# the redirect makes Perl use a shell; "command" is a builtin, not a program
not `command -v jq 2>/dev/null` and die "jq not found";
not `command -v tar 2>/dev/null` and die "tar not found";
not `command -v curl 2>/dev/null` and die "curl not found";

sub lookup_file {
    my $os   = lc(`uname -s`);
    my $arch = `uname -m`;
    chomp( $arch, $os );

    # uname and Go name some architectures differently
    my %goarch = ( x86_64 => 'amd64', aarch64 => 'arm64' );
    $arch = $goarch{$arch} // $arch;
    my $file = `curl -sSL "https://go.dev/dl/?mode=json" \\
       | jq -r '.[0].files[]
       | select(.os == "$os")
       | select(.kind == "archive")
       | select(.arch == "$arch")
       | .filename'`;
    chomp($file);
    return $file;
}

sub downloads {
    my $downloads = $ENV{DOWNLOADS} || '/tmp';
    my $homedown  = $ENV{HOME} . "/Downloads";
    $downloads = $homedown if -d $homedown;
    return $downloads;
}

my $file = lookup_file();
not $file and die "no file found to fetch";
my $downloads = downloads();
my $path      = $downloads . '/' . $file;
my $dir       = $ENV{HOME} . "/.local";

say "Installing Go into $dir ... ";

# never remove the installed Go unless the new one has arrived
system( 'curl', '-fL', "https://go.dev/dl/$file", '-o', $path ) == 0
  or die "download failed";
`mkdir -p "$dir"`;
`rm -rf $dir/go`;
system( 'tar', '-C', $dir, '-xzf', $path ) == 0 or die "unpacking failed";

say "Installed.";
