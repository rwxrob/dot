#!/usr/bin/perl
use v5.26;
use File::Basename;

# the redirect makes Perl use a shell; "command" is a builtin, not a program
not `command -v cowsay 2>/dev/null`  and say 'cowsay not found'  and exit 1;
not `command -v lolcat 2>/dev/null`  and say 'lolcat not found'  and exit 1;
not `command -v fortune 2>/dev/null` and say 'fortune not found' and exit 1;

my $clear  = "[2J";
my $curoff = "[?25l";
my $curon  = "[?25h";
my $top    = "[H";

sub cleanup {
    print "$curon$clear";
    exit 0;
}
$SIG{'INT'}  = \&cleanup;
$SIG{'TERM'} = \&cleanup;

print $clear . $curoff;

while (1) {
    my $pid = fork();
    if ( !defined $pid ) {
        die "Failed to fork: $!";
    }
    if ( $pid == 0 ) {
        print $curoff. $clear . $top;
        exec
        #"fortune $ENV{REPOS}/github.com/rwxrob/dot/config/fortunes/combined | cowsay -W 50 -f '$ENV{REPOS}/github.com/rwxrob/dot/config/cowsay/default.cow' | indent 15 | lolcat -ft | cat"
          exec "fortune | cowsay -W 50 -f '$ENV{REPOS}/github.com/rwxrob/dot/config/cowsay/default.cow' | indent 15 | lolcat -ft | cat"
          or die "Failed to exec cowsay";
    }
    else {
        waitpid( $pid, 0 );
        sleep 10;
    }
}

