#!/bin/sh
set -e

root=$(cd -- "$(dirname -- "$0")" && { realpath . 2>/dev/null || pwd; })

# the old ~/Scripts link points at the former scripts/ directory; drop it
if [ -L "$HOME/Scripts" ] && [ ! -e "$HOME/Scripts" ]; then
	rm -f "$HOME/Scripts"
fi

# one tool failing (usually because it is not installed) never stops the rest
failed=
for i in bash wsl wezterm vim lynx gh git tmux k9s docker podman iam opencode; do
	if ! (cd "$root/config/$i" && ./setup); then
		failed="$failed $i"
	fi
done

if [ -n "$failed" ]; then
	echo "setup did not finish for:$failed" >&2
	exit 1
fi
